# Core runtime selection
NETWORK_MODE=prod # Network mode: test = testnet, prod = mainnet
STRATEGY_VERSION=v1

# RPC and WebSocket providers
ALCHEMY_RPC_URL_TEST=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_RPC_URL_PROD=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_WS_URL_TEST=wss://arb-sepolia.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_WS_URL_PROD=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Wallet material
WALLET_PRIVATE_KEY_TEST=0xYOUR_TEST_PRIVATE_KEY
WALLET_PRIVATE_KEY_PROD=0xYOUR_PROD_PRIVATE_KEY
WALLET_MNEMONIC_TEST="replace with your test mnemonic"
WALLET_MNEMONIC_PROD="replace with your prod mnemonic"

# External services
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/crypto_yield_farming_bot
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
ZEROX_API_KEY=YOUR_ZEROX_API_KEY

# Optional feature flags
REFETCH_ABIS=false
LOG_TO_FILE=false

# Logging
CONSOLE_LOG_LEVEL=INFO
FILE_LOG_LEVEL=INFO
LOKI_LOG_LEVEL=TRACE

# Runtime overrides
REDIS_URL=redis://127.0.0.1:6379
STRATEGY_RUNNER_HANG_TIMEOUT_SECS=3000
STRATEGY_RUNNER_RUN_TIMEOUT_SECS=600
TRADING_BOT_HANG_TIMEOUT_SECS=3000
TRADING_BOT_RUN_TIMEOUT_SECS=1200
TRADING_BOT_STABLE_ONLY_TICK_SECS=180

# Usually injected by docker compose rather than stored in .env.
# Uncomment only if you want to override that behavior explicitly.
# STAGE=prod
# DEPLOYMENT=docker
# CONTAINER_NAME=executor
# DYDX_CONFIG_PATH=src/hedging/dydx_mainnet.toml
